@model Interview.Web.Models.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<div class="catalog-shell">
    <a href="@Model.ReturnUrl" class="btn btn-outline-secondary mb-4">Back to products</a>

    <section class="product-detail-panel">
        <div class="product-image-placeholder product-image-placeholder--detail mb-4" role="img" aria-label="Product image placeholder">
            <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <rect x="7" y="9" width="34" height="30" rx="4"></rect>
                <circle cx="18" cy="19" r="3"></circle>
                <path d="M10 34l10-10 6 6 5-5 7 9"></path>
            </svg>
            <span>Product image</span>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <p class="text-uppercase text-muted fw-semibold letter-spacing mb-2">Product details</p>
                <h1 class="display-6 fw-bold mb-0">@Model.Name</h1>
            </div>
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary") fs-6">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <h2 class="h6 text-muted">SKU</h2>
                <div class="product-detail-value">@Model.Sku</div>
            </div>
            <div class="col-md-6">
                <h2 class="h6 text-muted">Category</h2>
                <div class="product-detail-value">@Model.CategoryName</div>
            </div>
            <div class="col-12">
                <h2 class="h6 text-muted">Product ID</h2>
                <div class="product-detail-value text-break">@Model.Id</div>
            </div>
        </div>
    </section>
</div>
